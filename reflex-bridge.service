[Unit]
Description=Reflex RC-controller Interface -> uinput joystick bridge
# Run only while the controller is plugged in (alias set by 99-reflex-rc.rules)
BindsTo=dev-reflexrc.device
After=graphical-session.target dev-reflexrc.device

[Service]
Type=simple
WorkingDirectory=/home/simon/Documents/myOSS/reflex-bridge
ExecStart=/home/simon/.local/bin/uv run python -u bridge.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
